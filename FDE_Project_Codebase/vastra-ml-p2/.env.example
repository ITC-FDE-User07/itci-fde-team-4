# Copy to .env. P2 reads the ready tables of the data platform next door.
DATA_DIR=../vastra-data-platform/data
REPORTS_DIR=../vastra-data-platform/reports
P2_OUT_DIR=out
P2_TOP_K=40
P2_TEST_WEEKS=8
P2_GATE_POINTS=10
# Kill switch for the job's default; the API's PUT /v1/admin/p2-mode overrides it for planners.
P2_MODE=model
VASTRA_DATA_USER=p2-job
