# Copy to .env (never commit .env). Paths are relative to the vastra-data-platform folder.
DATA_DIR=data
INBOX_DIR=inbox
REPORTS_DIR=reports
# The Week 1 API's integration feed (the outbox). The data platform has its own read-only key.
VASTRA_API_URL=http://127.0.0.1:8200
VASTRA_API_KEY=dev-data-key
# Legacy database, opened read-only (never with the shared vastra_admin login)
LEGACY_DB_PATH=../vastra-legacy-lab/data/vastra_legacy.db
# Named person running the job: written to access_log and failed_records
VASTRA_DATA_USER=your.name
WEEK1_CUTOVER=2026-11-10
# Optional: also post alerts to a chat or email webhook
# ALERT_WEBHOOK_URL=
